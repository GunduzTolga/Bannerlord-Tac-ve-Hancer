<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Taç ve Hançer (iç kimlik CheatMenu). Oyunun ve kütüphanelerin DLL'leri sürümü sabitlenmiş NuGet paketlerinden gelir:
    derleme oyun klasörüne bağlı değildir (GitHub'da da derlenir). Oyun klasörü varsa derleme sonunda mod oraya kopyalanır.
    Oyun klasörü farklıysa: dotnet build src\CheatMenu.csproj -c Release -p:GameFolder="D:\Oyunlar\Mount & Blade II Bannerlord"
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>CheatMenu</AssemblyName>
    <RootNamespace>CheatMenu</RootNamespace>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Oyun sürümü: referans DLL'leri bu sürümden gelir. Oyun güncellenince burası ve SubModule.xml güncellenir. -->
    <GameVersion>1.4.8.119303</GameVersion>
    <GameFolder Condition=" '$(GameFolder)' == '' ">C:\Program Files (x86)\Steam\steamapps\common\Mount &amp; Blade II Bannerlord</GameFolder>
    <ModuleOut>$(GameFolder)\Modules\CheatMenu</ModuleOut>
  </PropertyGroup>

  <!-- Hepsi yalnızca derleme içindir (runtime'da oyun ve kurulu modüller sağlar), mod klasörüne kopyalanmaz. -->
  <ItemGroup>
    <PackageReference Include="Bannerlord.ReferenceAssemblies.Core" Version="$(GameVersion)" PrivateAssets="all" IncludeAssets="compile" />
    <PackageReference Include="Bannerlord.ReferenceAssemblies.SandBox" Version="$(GameVersion)" PrivateAssets="all" IncludeAssets="compile" />
    <PackageReference Include="Lib.Harmony.Ref" Version="2.4.2" PrivateAssets="all" IncludeAssets="compile" />
    <PackageReference Include="Bannerlord.MCM" Version="5.13.1" PrivateAssets="all" IncludeAssets="compile" />
    <!-- SubModule.xml'deki en düşük sürüm; yalnızca 2.13 ve 3.x'te ortak API kullanılır. -->
    <PackageReference Include="Bannerlord.UIExtenderEx" Version="2.13.3" PrivateAssets="all" IncludeAssets="compile" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Module klasörü (SubModule.xml, GUI prefab/fırçaları, resimler) oyundaki modül klasörüne olduğu gibi kopyalanır. -->
  <ItemGroup>
    <ModuleAsset Include="$(MSBuildProjectDirectory)\..\Module\**\*.*" />
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build">
    <Message Condition="!Exists('$(GameFolder)\bin\Win64_Shipping_Client')" Importance="high"
             Text="Oyun klasörü bulunamadı ($(GameFolder)); mod kopyalanmadı. -p:GameFolder=... ile belirt." />
    <MakeDir Condition="Exists('$(GameFolder)\bin\Win64_Shipping_Client')" Directories="$(ModuleOut)\bin\Win64_Shipping_Client" />
    <Copy Condition="Exists('$(GameFolder)\bin\Win64_Shipping_Client')"
          SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModuleOut)\bin\Win64_Shipping_Client" />
    <Copy Condition="Exists('$(GameFolder)\bin\Win64_Shipping_Client')"
          SourceFiles="@(ModuleAsset)" DestinationFiles="@(ModuleAsset->'$(ModuleOut)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <!-- third_party\paketler.txt'deki modlar aynı klasöre paketlenir: launcher'da tek mod görünür (bkz. tools\bundle.ps1). -->
    <Exec Condition="Exists('$(GameFolder)\bin\Win64_Shipping_Client') And Exists('$(MSBuildProjectDirectory)\..\third_party\paketler.txt')"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\tools\bundle.ps1&quot; -ModuleOut &quot;$(ModuleOut)&quot;" />
    <Message Condition="Exists('$(GameFolder)\bin\Win64_Shipping_Client')" Importance="high" Text="Taç ve Hançer -> $(ModuleOut)" />
  </Target>
</Project>
