<?xml version="1.0" encoding="utf-8"?>
<!-- Savaş Raporu bölümü (ViewModel: WarSectionVM): başlık, ayraç, iki tarafın adı, karşılaştırma satırları (TvhWarRow), düz satırlar (TvhWarLine). -->
<Prefab>
  <Window>
    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginBottom="22" StackLayout.LayoutMethod="VerticalTopToBottom">
      <Children>
        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="34" Brush="Tvh.Text.SectionCenter" Text="@Title" />
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="23" MarginLeft="60" MarginRight="60" Sprite="StdAssets\Popup\divider" DoNotAcceptEvents="true" />
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="670" SuggestedHeight="26" HorizontalAlignment="Center" IsVisible="@HasSides">
          <Children>
            <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="200" HorizontalAlignment="Left" Brush="Tvh.Text.GoldCenter" Text="@OursName" />
            <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="200" HorizontalAlignment="Right" Brush="Tvh.Text.GoldCenter" Text="@TheirsName" />
          </Children>
        </Widget>
        <ListPanel DataSource="{Rows}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
          <ItemTemplate>
            <TvhWarRow />
          </ItemTemplate>
        </ListPanel>
        <ListPanel DataSource="{Lines}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="4" StackLayout.LayoutMethod="VerticalTopToBottom">
          <ItemTemplate>
            <TvhWarLine />
          </ItemTemplate>
        </ListPanel>
      </Children>
    </ListPanel>
  </Window>
</Prefab>
