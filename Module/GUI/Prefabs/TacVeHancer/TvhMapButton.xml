<?xml version="1.0" encoding="utf-8"?>
<!--
  Haritadaki "Entrika" düğmesi (ViewModel: MapButtonVM). Kök parça olay almaz: yalnızca düğmenin üstüne tıklamak
  bu katmana gider, haritanın geri kalanı her zamanki gibi çalışır. Yer ayarı: sol üst / üst orta / sağ üst.
-->
<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" DoNotAcceptEvents="true">
      <Children>
        <TvhMapButtonItem HorizontalAlignment="Left" MarginLeft="24" IsVisible="@IsTopLeft" />
        <TvhMapButtonItem HorizontalAlignment="Center" IsVisible="@IsTopCenter" />
        <TvhMapButtonItem HorizontalAlignment="Right" MarginRight="24" IsVisible="@IsTopRight" />
      </Children>
    </Widget>
  </Window>
</Prefab>
