<?xml version="1.0" encoding="utf-8"?>
<!-- Sekme ya da filtre düğmesi (ViewModel: TabVM). Oyunun açılır pencere düğmesi; seçiliyken altın parıltı (Tvh.Tab). -->
<Prefab>
  <Window>
    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="138" SuggestedHeight="44" MarginRight="2" Brush="Tvh.Tab" IsSelected="@IsSelected" Command.Click="ExecuteSelect" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
      <Children>
        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="8" MarginRight="8" Brush="Tvh.Text.Tab" Text="@Name" />
      </Children>
    </ButtonWidget>
  </Window>
</Prefab>
