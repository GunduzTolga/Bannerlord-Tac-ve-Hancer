              </Children>
            </Widget>
            <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="120" SuggestedHeight="22" MarginLeft="268" MarginTop="72" Brush="Tvh.Text.Gold" Text="@LevelText" />
