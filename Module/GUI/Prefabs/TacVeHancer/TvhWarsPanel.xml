<?xml version="1.0" encoding="utf-8"?>
<!--
  Savaş ve barış > Savaşlar paneli (ViewModel: WarsVM). Solda savaştığın krallıklar (TvhWarItem), sağda seçilinin Barış Masası
  (TvhPeaceTablePanel). Savaş yoksa ya da krallıkta değilsen açıklama.
-->
<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>
        <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="80" MarginRight="80" Brush="Tvh.Text.BodyCenter" Text="@EmptyText" IsVisible="@HasNoWars" />

        <!-- ===== Sol: savaşlar ===== -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="420">
          <Children>
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="32" MarginLeft="6" Brush="Tvh.Text.Section" Text="@WarsTitle" />
            <ScrollablePanel Id="WarsScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="36" MarginRight="18" AutoHideScrollBars="true" ClipRect="WarsClip" InnerPanel="WarsClip\WarsList" VerticalScrollbar="..\WarsBar\Scrollbar">
              <Children>
                <Widget Id="WarsClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                  <Children>
                    <ListPanel Id="WarsList" DataSource="{Items}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                      <ItemTemplate>
                        <TvhWarItem />
                      </ItemTemplate>
                    </ListPanel>
                  </Children>
                </Widget>
              </Children>
            </ScrollablePanel>
            <Standard.VerticalScrollbar Id="WarsBar" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right" MarginTop="36" />
          </Children>
        </Widget>

        <!-- ===== Sağ: seçili savaşın Barış Masası ===== -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="444" IsVisible="@HasTable">
          <Children>
            <TvhPeaceTablePanel DataSource="{Table}" />
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
