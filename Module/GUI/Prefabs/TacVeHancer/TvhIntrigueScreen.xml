<?xml version="1.0" encoding="utf-8"?>
<!--
  Yedek ayrı Entrika ekranı (ViewModel: CheatMenu.UI.ViewModels.IntrigueScreenVM). Normalde Entrika, Klan ekranının bir
  sekmesidir (ClanIntrigueTab); bu ekran yalnızca UIExtenderEx kaydı tutmazsa açılır. İçerik TvhIntriguePanel ile aynı.
  Pencere 1680x940 (oyun 1920x1080'e göre ölçekler).
-->
<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

        <!-- Karartma: alttaki haritaya tıklanmasın -->
        <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Backdrop" DoNotPassEventsToChildren="true" />

        <!-- Pencere: oyunun açılır pencere tuvali ve çerçevesi -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1680" SuggestedHeight="940" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="StdAssets\Popup\canvas">
          <Children>

            <!-- ===== Başlık ===== -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="84" VerticalAlignment="Top">
              <Children>
                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="500" SuggestedHeight="52" MarginLeft="34" MarginTop="14" Brush="Tvh.Text.Title" Text="@TitleText" />
                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="30" StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <Children>
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="200" SuggestedHeight="44" MarginRight="14" Brush="Tvh.Button" Command.Click="ExecuteClassicMenu" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Text.Button" Text="@ClassicMenuText" />
                      </Children>
                    </ButtonWidget>
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="160" SuggestedHeight="44" Brush="Tvh.Button.Primary" Command.Click="ExecuteClose" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Text.Button" Text="@CloseText" />
                      </Children>
                    </ButtonWidget>
                  </Children>
                </ListPanel>
              </Children>
            </Widget>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="23" VerticalAlignment="Top" MarginTop="76" MarginLeft="22" MarginRight="22" Sprite="StdAssets\Popup\divider" DoNotAcceptEvents="true" />

            <!-- ===== Gövde ===== -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="104" MarginBottom="20" MarginLeft="28" MarginRight="28">
              <Children>
                <TvhIntriguePanel />
              </Children>
            </Widget>

            <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Popup.Frame" DoNotAcceptEvents="true" />
          </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>
