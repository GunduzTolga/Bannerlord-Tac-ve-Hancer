<?xml version="1.0" encoding="utf-8"?>
<!--
  Entrika paneli (ViewModel: CheatMenu.UI.ViewModels.IntrigueScreenVM). İki yerde kullanılır:
  - Klan ekranının "Entrika" sekmesi: alt yarıya yerleşir (ClanIntrigueTab.cs içindeki prefab eki); üst şerit, arka plan ve
    "Bitti" düğmesi oyunun kendisi.
  - Yedek ayrı ekran (TvhIntrigueScreen): UIExtenderEx kaydı tutmazsa.
  Üstte bölümler (TvhGroupTab: Entrika, Kişiler, Saray, Savaş ve barış) ve seçili bölümün alt sekmeleri (TvhSubTab). Her özellik tek bir
  alt sekmede (tasarım: docs/superpowers/specs/2026-10-21-arayuz-duzeni.md). Casus başı sütunu (Tvh.Panel) yalnızca Entrika bölümünde;
  öteki bölümlerde içerik tam genişlik (ContentMargin).
  Liste deseni: ScrollablePanel > ClipRect (ClipContents) > ListPanel (CoverChildren) + yanında oyunun Standard.VerticalScrollbar'ı.
  Sprite'lar her zaman yüklü (ui_group1) olanlardan; oyundan kopyalanan fırçalar Klan kategorisini de kullanabilir (TvhUi.GameLooks).
-->
<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

        <!-- ===== Üst: bölümler ve alt sekmeler ===== -->
        <ListPanel DataSource="{Groups}" WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="46" StackLayout.LayoutMethod="HorizontalLeftToRight">
          <ItemTemplate>
            <TvhGroupTab />
          </ItemTemplate>
        </ListPanel>
        <ListPanel DataSource="{Tabs}" WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="38" MarginTop="54" StackLayout.LayoutMethod="HorizontalLeftToRight">
          <ItemTemplate>
            <TvhSubTab />
          </ItemTemplate>
        </ListPanel>
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" MarginTop="98" Sprite="SPGeneral\SPOptions\options_divider_flat" DoNotAcceptEvents="true" />

        <!-- ===== Sol sütun: casus başı (yalnızca Entrika bölümünde) ===== -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="330" HorizontalAlignment="Left" MarginTop="108" MarginBottom="34" IsVisible="@IsIntrigueGroup">
          <Children>
        <BrushWidget DataSource="{Spymaster}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Panel">
          <Children>
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="34" MarginTop="10" Brush="Tvh.Text.PanelTitle" Text="Casus başı" />
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="23" MarginTop="44" MarginLeft="6" MarginRight="6" Sprite="StdAssets\Popup\divider" DoNotAcceptEvents="true" />

            <!-- Casus başı var -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@HasSpymaster">
              <Children>
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="250" SuggestedHeight="188" HorizontalAlignment="Center" MarginTop="76" Sprite="BlankWhiteSquare_9" Color="#8C6D3FFF">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="2" MarginRight="2" MarginTop="2" MarginBottom="2" Sprite="BlankWhiteSquare_9" Color="#0E0B08FF">
                      <Children>
                        <ImageIdentifierWidget DataSource="{Portrait}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ImageId="@Id" AdditionalArgs="@AdditionalArgs" TextureProviderName="@TextureProviderName" />
                      </Children>
                    </Widget>
                  </Children>
                </Widget>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="32" MarginLeft="18" MarginRight="18" MarginTop="272" Brush="Tvh.Text.NameCenter" Text="@Name" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="24" MarginLeft="18" MarginRight="18" MarginTop="306" Brush="Tvh.Text.Gold" Text="@SkillText" />
                <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="46" MarginLeft="18" MarginRight="18" MarginTop="334" Brush="Tvh.Text.SmallTop" Text="@StatusText" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="24" MarginLeft="18" MarginRight="18" MarginTop="382" Brush="Tvh.Text.Small" Text="@LimitsText" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="24" MarginLeft="18" MarginRight="18" MarginTop="408" Brush="Tvh.Text.Muted" Text="@IntelText" />
                <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="46" MarginLeft="18" MarginRight="18" MarginTop="436" Brush="Tvh.Text.SmallTop" Text="@MissionText" />

                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" VerticalAlignment="Bottom" MarginLeft="18" MarginRight="18" MarginBottom="20" StackLayout.LayoutMethod="VerticalTopToBottom">
                  <Children>
                    <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="44" MarginBottom="8" Brush="Tvh.Button.Primary" Command.Click="ExecuteMission" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Text.Button" Text="@MissionButtonText" />
                      </Children>
                    </ButtonWidget>
                    <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="44" MarginBottom="8" Brush="Tvh.Button" Command.Click="ExecuteAssign" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Text.Button" Text="@ChangeText" />
                      </Children>
                    </ButtonWidget>
                    <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="44" Brush="Tvh.Button.Danger" Command.Click="ExecuteDismiss" IsEnabled="@CanDismiss" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Text.Button" Text="@DismissText" />
                      </Children>
                    </ButtonWidget>
                  </Children>
                </ListPanel>
              </Children>
            </Widget>

            <!-- Casus başı yok -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@HasNoSpymaster">
              <Children>
                <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="240" MarginLeft="20" MarginRight="20" MarginTop="84" Brush="Tvh.Text.Body" Text="@EmptyText" />
                <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="48" VerticalAlignment="Bottom" MarginLeft="18" MarginRight="18" MarginBottom="20" Brush="Tvh.Button.Primary" Command.Click="ExecuteAssign" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Text.Button" Text="@AssignText" />
                  </Children>
                </ButtonWidget>
              </Children>
            </Widget>
          </Children>
        </BrushWidget>
          </Children>
        </Widget>

        <!-- ===== Sekmenin içeriği ===== -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="@ContentMargin" MarginTop="108" MarginBottom="34">
          <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
              <Children>

                <!-- ===== Süren entrikalar ===== -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsSchemesTab">
                  <Children>
                    <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="80" MarginRight="80" Brush="Tvh.Text.BodyCenter" Text="@SchemesEmptyText" IsVisible="@HasNothingRunning" />
                    <ScrollablePanel Id="SchemesScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginRight="18" AutoHideScrollBars="true" ClipRect="SchemesClip" InnerPanel="SchemesClip\SchemesInner" VerticalScrollbar="..\SchemesBar\Scrollbar">
                      <Children>
                        <Widget Id="SchemesClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                          <Children>
                            <ListPanel Id="SchemesInner" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <Children>
                                <ListPanel DataSource="{Schemes}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                                  <ItemTemplate>
                                    <TvhSchemeCard />
                                  </ItemTemplate>
                                </ListPanel>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="34" MarginTop="6" Brush="Tvh.Text.Section" Text="@LettersHeader" IsVisible="@HasLetters" />
                                <ListPanel DataSource="{Letters}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                                  <ItemTemplate>
                                    <TvhLetterRow />
                                  </ItemTemplate>
                                </ListPanel>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="34" MarginTop="6" Brush="Tvh.Text.Section" Text="@RomancesHeader" IsVisible="@HasRomances" />
                                <ListPanel DataSource="{Romances}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                                  <ItemTemplate>
                                    <TvhLetterRow />
                                  </ItemTemplate>
                                </ListPanel>
                              </Children>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </ScrollablePanel>
                    <Standard.VerticalScrollbar Id="SchemesBar" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right" />
                  </Children>
                </Widget>

                <!-- ===== Yeni entrika ===== -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsNewTab">
                  <Children>
                    <TvhNewSchemePanel DataSource="{NewScheme}" />
                  </Children>
                </Widget>

                <!-- ===== Kişiler ===== -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsPeopleTab">
                  <Children>
                    <TvhPeoplePanel DataSource="{People}" />
                  </Children>
                </Widget>

                <!-- ===== Esirler ===== -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsPrisonersTab">
                  <Children>
                    <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="56" Brush="Tvh.Text.SmallTop" Text="@PrisonersInfoText" />
                    <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="70" Brush="Tvh.Text.BodyCenter" Text="Elinde esir bir kahraman yok." IsVisible="@HasNoPrisoners" />
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="70">
                      <Children>
                        <ScrollablePanel Id="PrisonersScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginRight="18" AutoHideScrollBars="true" ClipRect="PrisonersClip" InnerPanel="PrisonersClip\PrisonersList" VerticalScrollbar="..\PrisonersBar\Scrollbar">
                          <Children>
                            <Widget Id="PrisonersClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                              <Children>
                                <ListPanel Id="PrisonersList" DataSource="{Prisoners}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                                  <ItemTemplate>
                                    <TvhPrisonerCard />
                                  </ItemTemplate>
                                </ListPanel>
                              </Children>
                            </Widget>
                          </Children>
                        </ScrollablePanel>
                        <Standard.VerticalScrollbar Id="PrisonersBar" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right" />
                      </Children>
                    </Widget>
                  </Children>
                </Widget>

                <!-- ===== Saray ===== -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsCourtTab">
                  <Children>
                    <TvhCourtPanel DataSource="{Court}" />
                  </Children>
                </Widget>

                <!-- ===== Divan ===== -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsCouncilTab">
                  <Children>
                    <TvhCouncilPanel DataSource="{Council}" />
                  </Children>
                </Widget>

                <!-- ===== Gölge ağları ===== -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsNetworksTab">
                  <Children>
                    <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="56" Brush="Tvh.Text.SmallTop" Text="@NetworksInfoText" />
                    <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="70" Brush="Tvh.Text.BodyCenter" Text="Henüz bir gölge ağın yok." IsVisible="@HasNoNetworks" />
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="70">
                      <Children>
                        <ScrollablePanel Id="NetworksScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginRight="18" AutoHideScrollBars="true" ClipRect="NetworksClip" InnerPanel="NetworksClip\NetworksList" VerticalScrollbar="..\NetworksBar\Scrollbar">
                          <Children>
                            <Widget Id="NetworksClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                              <Children>
                                <ListPanel Id="NetworksList" DataSource="{Networks}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                                  <ItemTemplate>
                                    <TvhNetworkCard />
                                  </ItemTemplate>
                                </ListPanel>
                              </Children>
                            </Widget>
                          </Children>
                        </ScrollablePanel>
                        <Standard.VerticalScrollbar Id="NetworksBar" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right" />
                      </Children>
                    </Widget>
                  </Children>
                </Widget>

                <!-- ===== Sana karşı ===== -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsPlotsTab">
                  <Children>
                    <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="80" MarginRight="80" Brush="Tvh.Text.BodyCenter" Text="@PlotsEmptyText" IsVisible="@HasNoPlots" />
                    <ScrollablePanel Id="PlotsScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginRight="18" AutoHideScrollBars="true" ClipRect="PlotsClip" InnerPanel="PlotsClip\PlotsList" VerticalScrollbar="..\PlotsBar\Scrollbar">
                      <Children>
                        <Widget Id="PlotsClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                          <Children>
                            <ListPanel Id="PlotsList" DataSource="{Plots}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <ItemTemplate>
                                <TvhPlotCard />
                              </ItemTemplate>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </ScrollablePanel>
                    <Standard.VerticalScrollbar Id="PlotsBar" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right" />
                  </Children>
                </Widget>

                <!-- ===== Lordlar ===== -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsLordsTab">
                  <Children>
                    <TvhLordsPanel DataSource="{Lords}" />
                  </Children>
                </Widget>

                <!-- ===== Savaşlar ve Barış Masası ===== -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsWarsTab">
                  <Children>
                    <TvhWarsPanel DataSource="{Wars}" />
                  </Children>
                </Widget>

                <!-- ===== İsyanlar ===== -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsRebellionsTab">
                  <Children>
                    <TvhRebellionsPanel DataSource="{Rebellions}" />
                  </Children>
                </Widget>

                <!-- ===== Kronik ===== -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsLogTab">
                  <Children>
                    <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="800" SuggestedHeight="40" Brush="Tvh.Text.Small" Text="@LogInfoText" />
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="220" SuggestedHeight="42" HorizontalAlignment="Right" MarginRight="18" Brush="Tvh.Button" Command.Click="ExecuteExportLog" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Text.Button" Text="@ExportText" />
                      </Children>
                    </ButtonWidget>
                    <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="54" Brush="Tvh.Text.BodyCenter" Text="Henüz bir şey olmadı." IsVisible="@HasNoLog" />
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="54">
                      <Children>
                        <ScrollablePanel Id="LogScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginRight="18" AutoHideScrollBars="true" ClipRect="LogClip" InnerPanel="LogClip\LogList" VerticalScrollbar="..\LogBar\Scrollbar">
                          <Children>
                            <Widget Id="LogClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                              <Children>
                                <ListPanel Id="LogList" DataSource="{Log}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                                  <ItemTemplate>
                                    <TvhLogRow />
                                  </ItemTemplate>
                                </ListPanel>
                              </Children>
                            </Widget>
                          </Children>
                        </ScrollablePanel>
                        <Standard.VerticalScrollbar Id="LogBar" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right" />
                      </Children>
                    </Widget>
                  </Children>
                </Widget>

              </Children>
            </Widget>
          </Children>
        </Widget>

        <!-- ===== Alt satır: tarih, kese, son durum ===== -->
        <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="700" SuggestedHeight="26" VerticalAlignment="Bottom" MarginLeft="4" Brush="Tvh.Text.Muted" Text="@SubtitleText" />
        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26" VerticalAlignment="Bottom" MarginLeft="720" MarginRight="4" Brush="Tvh.Text.MutedRight" Text="@StatusText" />

      </Children>
    </Widget>
  </Window>
</Prefab>
