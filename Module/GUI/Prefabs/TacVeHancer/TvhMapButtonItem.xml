<?xml version="1.0" encoding="utf-8"?>
<!-- TvhMapButton içindeki tek düğme; yeri onu kullanan yerde verilir. Rozet: harekete geçmeye hazır entrika + sezilen tehdit sayısı. -->
<Prefab>
  <Window>
    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="170" SuggestedHeight="42" VerticalAlignment="Top" MarginTop="14" Brush="Tvh.MapButton" Command.Click="ExecuteOpen" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
      <Children>
        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Text.MapButton" Text="@Label" />
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="26" SuggestedHeight="26" HorizontalAlignment="Right" VerticalAlignment="Top" PositionXOffset="10" PositionYOffset="-10" Sprite="BlankWhiteSquare_9" Color="#A8352AFF" IsVisible="@HasBadge">
          <Children>
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Text.Badge" Text="@BadgeText" />
          </Children>
        </Widget>
      </Children>
    </ButtonWidget>
  </Window>
</Prefab>
