<?xml version="1.0" encoding="utf-8"?>
<!-- Divan sekmesi (ViewModel: CouncilVM): üstte dört koltuk (TvhCouncilSeat), altında raporlar (TvhCouncilRow). -->
<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>
        <ListPanel DataSource="{Seats}" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="200" StackLayout.LayoutMethod="HorizontalLeftToRight">
          <ItemTemplate>
            <TvhCouncilSeat />
          </ItemTemplate>
        </ListPanel>

        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="210">
          <Children>
            <ScrollablePanel Id="CouncilScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginRight="16" AutoHideScrollBars="true" ClipRect="CouncilClip" InnerPanel="CouncilClip\CouncilList" VerticalScrollbar="..\CouncilBar">
              <Children>
                <Widget Id="CouncilClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                  <Children>
                    <ListPanel Id="CouncilList" DataSource="{Rows}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                      <ItemTemplate>
                        <TvhCouncilRow />
                      </ItemTemplate>
                    </ListPanel>
                  </Children>
                </Widget>
              </Children>
            </ScrollablePanel>
            <ScrollbarWidget Id="CouncilBar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="8" HorizontalAlignment="Right" AlignmentAxis="Vertical" Handle="CouncilHandle" MinValue="0" MaxValue="100" Brush="Tvh.Scrollbar">
              <Children>
                <ImageWidget Id="CouncilHandle" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="60" HorizontalAlignment="Center" Brush="Tvh.Scrollbar.Handle" />
              </Children>
            </ScrollbarWidget>
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
