<?xml version="1.0" encoding="utf-8"?>
<!--
  Savaş Raporu (ViewModel: CheatMenu.UI.ViewModels.WarReportVM; UI.WarReportScreen). Pencere 1500x980.
  Üst kısım Diplomacy'nin kendi raporundan (third_party\Bannerlord.Diplomacy\GUI\Prefabs\WarExhaustion\DetailWarView.xml) aynen alındı ve
  onun ViewModel'ine bağlı (DataSource="{Report}", Diplomacy.ViewModel.DetailWarVM): çerçeve, büyük sancaklar, başlık, iki tarafın savaş
  yorgunluğu, ilişki kutuları, tarih. GuiCheck bu alt ağacı denetlemez (türü yalnızca çalışırken belli). Altı bizim: iki sütun bölüm.
-->
<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

        <!-- Karartma: alttaki ekrana tıklanmasın -->
        <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Backdrop" DoNotPassEventsToChildren="true" />

        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1500" SuggestedHeight="980" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Children>

            <!-- ===== Üst kısım: Diplomacy'nin raporu ===== -->
            <Widget DataSource="{Report}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
              <Children>
                <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Frame1Canvas">
                  <Children>
                    <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Frame1.Border" IsEnabled="true">
                      <Children>
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                          <Children>
                            <Standard.Background />
                            <MaskedTextureWidget PositionXOffset="-100" DataSource="{Faction1Visual}" ImageId="@Id" AdditionalArgs="@AdditionalArgs" ImageTypeCode="@ImageTypeCode" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="300" SuggestedHeight="490" HorizontalAlignment="Left" Brush="Encyclopedia.Faction.Banner" OverlayTextureScale="1.5" TextureProviderName="@TextureProviderName"/>
                            <MaskedTextureWidget PositionXOffset="100" DataSource="{Faction2Visual}" ImageId="@Id" AdditionalArgs="@AdditionalArgs" ImageTypeCode="@ImageTypeCode" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="300" SuggestedHeight="490" HorizontalAlignment="Right" Brush="Encyclopedia.Faction.Banner" OverlayTextureScale="1.5" TextureProviderName="@TextureProviderName"/>
                          </Children>
                        </Widget>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="436" SuggestedHeight="100" HorizontalAlignment="Center" VerticalAlignment="Top" Sprite="StdAssets\tabbar_long">
                          <Children>
                            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="30" HorizontalAlignment="Center" VerticalAlignment="Top" PositionYOffset="8" Brush="Kingdom.DecisionTitleBig.Text" Brush.FontSize="30" Text="@WarReportLabel"/>
                          </Children>
                        </Widget>

                        <StaticDiplomacyButton Parameter.FontSize="24" HorizontalAlignment="Left" MarginLeft="50" MarginTop="18" Parameter.HintDataSource="{HelpHint}" Parameter.YOffset="3" />

                        <ListPanel MarginTop="60" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom" HorizontalAlignment="Center">
                          <Children>
                            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center">
                              <Children>
                                <ListPanel HorizontalAlignment="Left" MarginTop="10" MarginBottom="5" MarginLeft="5" MarginRight="20" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom" DoNotPassEventsToChildren="true">
                                  <Children>
                                    <TextWidget VerticalAlignment="Bottom" HorizontalAlignment="Center" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Brush="ArmyManagement.Army.Tuple.Name" Brush.TextHorizontalAlignment="Center" Text="@WarExhaustionLabel"/>
                                    <CriticalThresholdTextWidget IsCritical="@PlayerWarExhaustionIsCritical" VerticalAlignment="Bottom" HorizontalAlignment="Center" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Brush="Map.WarExhaustionReport.Text" Brush.TextHorizontalAlignment="Center" Text="@PlayerWarExhaustion" />
                                    <HintWidget DataSource="{PlayerCriticaExhaustionlHint}" DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" IsEnabled="false"/>
                                  </Children>
                                </ListPanel>

                                <ListPanel MarginBottom="5" MarginLeft="5" MarginRight="5" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center">
                                  <Children>
                                    <Relationship VerticalAlignment="Top" DataSource="{Kingdom}"/>
                                    <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" DoNotPassEventsToChildren="true" UpdateChildrenStates="true" StackLayout.LayoutMethod="VerticalTopToBottom">
                                      <Children>
                                        <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="50" SuggestedHeight="50" HorizontalAlignment="Center" VerticalAlignment="Top" PositionYOffset="7" Brush="Diplomacy.Icon.WarIcon" />
                                        <HintWidget DataSource="{RateHelpHint}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginTop="10" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" IsEnabled="true">
                                          <Children>
                                            <TextWidget DataSource="{..}" VerticalAlignment="Center" HorizontalAlignment="Center" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Brush="Diplomacy.Faction.HelpButton" Text="@WarExhaustionRate" />
                                          </Children>
                                        </HintWidget>
                                      </Children>
                                    </ListPanel>
                                    <Relationship VerticalAlignment="Top" DataSource="{OpponentKingdom}"/>
                                  </Children>
                                </ListPanel>

                                <ListPanel HorizontalAlignment="Right" MarginTop="10" MarginBottom="5" MarginLeft="20" MarginRight="5" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom" DoNotPassEventsToChildren="true">
                                  <Children>
                                    <TextWidget VerticalAlignment="Bottom" HorizontalAlignment="Center" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Brush="ArmyManagement.Army.Tuple.Name" Brush.TextHorizontalAlignment="Center" Text="@WarExhaustionLabel"/>
                                    <CriticalThresholdTextWidget IsCritical="@OpponentWarExhaustionIsCritical" VerticalAlignment="Bottom" HorizontalAlignment="Center" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Brush="Map.WarExhaustionReport.Text" Brush.TextHorizontalAlignment="Center" Text="@OpponentWarExhaustion" />
                                    <HintWidget DataSource="{OpponentCriticaExhaustionlHint}" DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" IsEnabled="false"/>
                                  </Children>
                                </ListPanel>
                              </Children>
                            </ListPanel>
                            <TextWidget VerticalAlignment="Center" HorizontalAlignment="Center" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Brush="Info.Text" Brush.FontSize="20" Text="@StartDate" />
                            <TextWidget VerticalAlignment="Center" HorizontalAlignment="Center" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Brush="Info.Text" Brush.FontSize="20" Text="@Duration" />
                            <AutoHideTextWidget VerticalAlignment="Center" HorizontalAlignment="Center" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Brush="Diplomacy.Faction.HelpButton" Text="@ActiveQuestWarning">
                              <Children>
                                <HintWidget DataSource="{ActiveQuestHint}" DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" IsEnabled="false"/>
                              </Children>
                            </AutoHideTextWidget>
                          </Children>
                        </ListPanel>
                      </Children>
                    </BrushWidget>
                  </Children>
                </BrushWidget>
              </Children>
            </Widget>

            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="150" SuggestedHeight="44" HorizontalAlignment="Right" MarginRight="44" MarginTop="22" Brush="Tvh.Button.Primary" Command.Click="ExecuteClose" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Text.Button" Text="@CloseText" />
              </Children>
            </ButtonWidget>
            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="200" SuggestedHeight="44" HorizontalAlignment="Right" MarginRight="44" MarginTop="74" Brush="Tvh.Button" Command.Click="ExecutePeace" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Text.Button" Text="@PeaceText" />
              </Children>
            </ButtonWidget>

            <!-- ===== Alt kısım: bizim bölümler (Intrigue.WarReport), iki sütun ===== -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="330" MarginBottom="28" MarginLeft="40" MarginRight="40" Sprite="BlankWhiteSquare_9" Color="#0D0A07D9">
              <Children>
                <ScrollablePanel Id="ReportScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="16" MarginRight="28" MarginTop="14" MarginBottom="10" AutoHideScrollBars="true" ClipRect="ReportClip" InnerPanel="ReportClip\ReportColumns" VerticalScrollbar="..\ReportBar\Scrollbar">
                  <Children>
                    <Widget Id="ReportClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                      <Children>
                        <ListPanel Id="ReportColumns" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" StackLayout.LayoutMethod="HorizontalLeftToRight">
                          <Children>
                            <ListPanel DataSource="{LeftSections}" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="670" MarginRight="30" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <ItemTemplate>
                                <TvhWarSection />
                              </ItemTemplate>
                            </ListPanel>
                            <ListPanel DataSource="{RightSections}" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="670" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <ItemTemplate>
                                <TvhWarSection />
                              </ItemTemplate>
                            </ListPanel>
                          </Children>
                        </ListPanel>
                      </Children>
                    </Widget>
                  </Children>
                </ScrollablePanel>
                <Standard.VerticalScrollbar Id="ReportBar" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right" MarginRight="6" MarginTop="14" MarginBottom="10" />
              </Children>
            </Widget>

          </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>
