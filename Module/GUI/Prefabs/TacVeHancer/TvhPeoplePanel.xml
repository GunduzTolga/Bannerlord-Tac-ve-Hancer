<?xml version="1.0" encoding="utf-8"?>
<!--
  "Kişiler" paneli (ViewModel: PeopleVM). Solda hakkında bilgi olan kişiler (520), sağda seçilenin dosyası (DossierVM):
  rapor, sırlar, koz ve entrika başlatma; hepsi tek kaydırmalı sütunda.
-->
<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>
        <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="80" MarginRight="80" Brush="Tvh.Text.BodyCenter" Text="@EmptyText" IsVisible="@HasNoPeople" />

        <!-- ===== Sol: kişiler ===== -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="520">
          <Children>
            <ScrollablePanel Id="PeopleScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginRight="14" AutoHideScrollBars="true" ClipRect="PeopleClip" InnerPanel="PeopleClip\PeopleList" VerticalScrollbar="..\PeopleBar\Scrollbar">
              <Children>
                <Widget Id="PeopleClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                  <Children>
                    <ListPanel Id="PeopleList" DataSource="{People}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                      <ItemTemplate>
                        <TvhPersonRow />
                      </ItemTemplate>
                    </ListPanel>
                  </Children>
                </Widget>
              </Children>
            </ScrollablePanel>
            <Standard.VerticalScrollbar Id="PeopleBar" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right" />
          </Children>
        </Widget>

        <!-- ===== Sağ: dosya ===== -->
        <Widget DataSource="{Dossier}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="540">
          <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@HasPerson">
              <Children>
                <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Card" DoNotAcceptEvents="true" />
                <ScrollablePanel Id="DossierScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginRight="14" AutoHideScrollBars="true" ClipRect="DossierClip" InnerPanel="DossierClip\DossierInner" VerticalScrollbar="..\DossierBar\Scrollbar">
                  <Children>
                    <Widget Id="DossierClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                      <Children>
                        <ListPanel Id="DossierInner" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                          <Children>

                            <!-- Kimlik -->
                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="184">
                              <Children>
                                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="200" SuggestedHeight="152" MarginLeft="16" MarginTop="16" Sprite="BlankWhiteSquare_9" Color="#8C6D3FFF">
                                  <Children>
                                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="2" MarginRight="2" MarginTop="2" MarginBottom="2" Sprite="BlankWhiteSquare_9" Color="#0E0B08FF">
                                      <Children>
                                        <ImageIdentifierWidget DataSource="{Portrait}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ImageId="@Id" AdditionalArgs="@AdditionalArgs" TextureProviderName="@TextureProviderName" />
                                      </Children>
                                    </Widget>
                                  </Children>
                                </Widget>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="34" MarginLeft="234" MarginRight="16" MarginTop="34" Brush="Tvh.Text.Name" Text="@Name" />
                                <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="50" MarginLeft="234" MarginRight="16" MarginTop="72" Brush="Tvh.Text.SmallTop" Text="@Affiliation" />
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="24" MarginLeft="234" MarginRight="16" MarginTop="124" Brush="Tvh.Text.Gold" Text="@RelationText" />
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="24" MarginLeft="234" MarginRight="16" MarginTop="150" Brush="Tvh.Text.Small" Text="@CourtText" />
                              </Children>
                            </Widget>

                            <!-- Rapor -->
                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="16" MarginRight="16" MarginBottom="14" StackLayout.LayoutMethod="VerticalTopToBottom" IsVisible="@HasReport">
                              <Children>
                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" MarginBottom="8" Sprite="SPGeneral\SPOptions\options_divider_flat" />
                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40">
                                  <Children>
                                    <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="300" SuggestedHeight="24" Brush="Tvh.Text.Section" Text="@ReportHeader" />
                                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="150" SuggestedHeight="34" HorizontalAlignment="Right" Brush="Tvh.Button" Command.Click="ExecuteDeleteReport" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                                      <Children>
                                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Text.Button" Text="@DeleteReportText" />
                                      </Children>
                                    </ButtonWidget>
                                  </Children>
                                </Widget>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="24" MarginBottom="4" Brush="Tvh.Text.Gold" Text="@ReportTitle" />
                                <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="Tvh.Text.Body" Text="@ReportText" />
                              </Children>
                            </ListPanel>

                            <!-- Sırlar -->
                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="16" MarginRight="16" MarginBottom="14" StackLayout.LayoutMethod="VerticalTopToBottom" IsVisible="@HasSecrets">
                              <Children>
                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" MarginBottom="8" Sprite="SPGeneral\SPOptions\options_divider_flat" />
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="28" Brush="Tvh.Text.Section" Text="@SecretsHeader" />
                                <ListPanel DataSource="{Secrets}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                                  <ItemTemplate>
                                    <TvhSecretRow />
                                  </ItemTemplate>
                                </ListPanel>
                              </Children>
                            </ListPanel>

                            <!-- Koz -->
                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="16" MarginRight="16" MarginBottom="14" StackLayout.LayoutMethod="VerticalTopToBottom" IsVisible="@HasHook">
                              <Children>
                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" MarginBottom="8" Sprite="SPGeneral\SPOptions\options_divider_flat" />
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="28" Brush="Tvh.Text.Section" Text="@HookHeader" />
                                <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginBottom="8" Brush="Tvh.Text.Body" Text="@HookText" />
                                <ListPanel DataSource="{HookActions}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                                  <ItemTemplate>
                                    <TvhActionRow />
                                  </ItemTemplate>
                                </ListPanel>
                              </Children>
                            </ListPanel>

                            <!-- Entrika başlat -->
                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="16" MarginRight="16" MarginBottom="16" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <Children>
                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" MarginBottom="8" Sprite="SPGeneral\SPOptions\options_divider_flat" />
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="28" Brush="Tvh.Text.Section" Text="@StartHeader" />
                                <ListPanel DataSource="{StartActions}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                                  <ItemTemplate>
                                    <TvhActionRow />
                                  </ItemTemplate>
                                </ListPanel>
                              </Children>
                            </ListPanel>

                          </Children>
                        </ListPanel>
                      </Children>
                    </Widget>
                  </Children>
                </ScrollablePanel>
                <Standard.VerticalScrollbar Id="DossierBar" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right" />
              </Children>
            </Widget>
          </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>
