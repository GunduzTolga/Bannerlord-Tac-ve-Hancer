<?xml version="1.0" encoding="utf-8"?>
<!-- Sır satırı (ViewModel: SecretItemVM): ad, açıklama, durum; sağda "İfşa et". -->
<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginBottom="8">
      <Children>
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#241C15FF" />
        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="12" MarginRight="190" MarginTop="8" MarginBottom="8" StackLayout.LayoutMethod="VerticalTopToBottom">
          <Children>
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26" Brush="Tvh.Text.Name" Text="@Name" />
            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="Tvh.Text.SmallTop" Text="@Description" />
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="22" Brush="Tvh.Text.Muted" Text="@StateText" />
          </Children>
        </ListPanel>
        <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="160" SuggestedHeight="38" HorizontalAlignment="Right" MarginRight="12" MarginTop="10" Brush="Tvh.Button.Danger" Command.Click="ExecuteExpose" IsEnabled="@CanExpose" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
          <Children>
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Text.Button" Text="@ExposeText" />
          </Children>
        </ButtonWidget>
        <RichTextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="160" SuggestedHeight="40" HorizontalAlignment="Right" MarginRight="12" MarginTop="52" Brush="Tvh.Text.BadTop" Text="@ExposeHint" />
      </Children>
    </Widget>
  </Window>
</Prefab>
