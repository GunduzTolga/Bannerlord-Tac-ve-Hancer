<?xml version="1.0" encoding="utf-8"?>
<!--
  Lordlar penceresi (ViewModel: CheatMenu.UI.ViewModels.LordsVM; UI.LordsScreen): sekmeler (krallığın, tanıdıkların, davetliler),
  ziyafet düğmesi ve koşulu, lord kartları (TvhLordCard). Pencere 1300x900 (oyun 1920x1080'e göre ölçekler).
-->
<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

        <!-- Karartma: alttaki ekrana tıklanmasın -->
        <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Backdrop" DoNotPassEventsToChildren="true" />

        <!-- Pencere: oyunun açılır pencere tuvali ve çerçevesi -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1300" SuggestedHeight="900" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="StdAssets\Popup\canvas">
          <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="StdAssets\Popup\canvas_gradient" DoNotAcceptEvents="true" />

            <!-- ===== Başlık ===== -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="84" VerticalAlignment="Top">
              <Children>
                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="400" SuggestedHeight="52" MarginLeft="34" MarginTop="14" Brush="Tvh.Text.Title" Text="@Title" />
                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="30" StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <Children>
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="380" SuggestedHeight="44" MarginRight="14" Brush="Tvh.Button" Command.Click="ExecuteFeast" IsEnabled="@CanFeast" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="8" MarginRight="8" Brush="Tvh.Text.Button" Text="@FeastText" />
                      </Children>
                    </ButtonWidget>
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="160" SuggestedHeight="44" Brush="Tvh.Button.Primary" Command.Click="ExecuteClose" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Text.Button" Text="@CloseText" />
                      </Children>
                    </ButtonWidget>
                  </Children>
                </ListPanel>
              </Children>
            </Widget>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="23" VerticalAlignment="Top" MarginTop="76" MarginLeft="22" MarginRight="22" Sprite="StdAssets\Popup\divider" DoNotAcceptEvents="true" />

            <!-- Sekmeler, yer ve ziyafet koşulu -->
            <ListPanel DataSource="{Tabs}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MarginLeft="34" MarginTop="102" StackLayout.LayoutMethod="HorizontalLeftToRight">
              <ItemTemplate>
                <TvhSmallTab />
              </ItemTemplate>
            </ListPanel>
            <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="720" SuggestedHeight="24" MarginLeft="34" MarginTop="148" Brush="Tvh.Text.Muted" Text="@Subtitle" />
            <RichTextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="560" SuggestedHeight="52" HorizontalAlignment="Right" MarginRight="30" MarginTop="102" Brush="Tvh.Text.MutedRight" Text="@FeastHint" />

            <!-- ===== Gövde: lord kartları ===== -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="180" MarginBottom="24" MarginLeft="28" MarginRight="28">
              <Children>
                <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Text.BodyCenter" Text="@EmptyText" IsVisible="@HasNoLords" />
                <ScrollablePanel Id="LordsScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginRight="16" AutoHideScrollBars="true" ClipRect="LordsClip" InnerPanel="LordsClip\LordsList" VerticalScrollbar="..\LordsBar\Scrollbar">
                  <Children>
                    <Widget Id="LordsClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                      <Children>
                        <ListPanel Id="LordsList" DataSource="{Lords}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                          <ItemTemplate>
                            <TvhLordCard />
                          </ItemTemplate>
                        </ListPanel>
                      </Children>
                    </Widget>
                  </Children>
                </ScrollablePanel>
                <Standard.VerticalScrollbar Id="LordsBar" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right" />
              </Children>
            </Widget>

            <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Popup.Frame" DoNotAcceptEvents="true" />
          </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>
