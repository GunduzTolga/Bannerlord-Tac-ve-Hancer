<?xml version="1.0" encoding="utf-8"?>
<!-- Divanda bir koltuk (ViewModel: CouncilSeatVM). Boşsa açıklama ve "Ata"; doluysa portre, beceri, ayrıntı, durum ve düğmeler. -->
<Prefab>
  <Window>
    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="630" SuggestedHeight="170" MarginRight="10" Sprite="BlankWhiteSquare_9" Color="#3D3022FF">
      <Children>
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="1" MarginRight="1" MarginTop="1" MarginBottom="1" Sprite="BlankWhiteSquare_9" Color="#211A14FF">
          <Children>
            <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="300" SuggestedHeight="22" MarginLeft="14" MarginTop="8" Brush="Tvh.Text.Section" Text="@Header" />

            <!-- Boş koltuk -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsEmpty">
              <Children>
                <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="110" MarginLeft="14" MarginRight="190" MarginTop="38" Brush="Tvh.Text.MutedTop" Text="@EmptyText" />
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="160" SuggestedHeight="40" HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="14" Brush="Tvh.Button.Primary" Command.Click="ExecuteAssign" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Text.Button" Text="@AssignText" />
                  </Children>
                </ButtonWidget>
              </Children>
            </Widget>

            <!-- Dolu koltuk -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@HasPerson">
              <Children>
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="130" SuggestedHeight="100" MarginLeft="14" MarginTop="38" Sprite="BlankWhiteSquare_9" Color="#8C6D3FFF">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="2" MarginRight="2" MarginTop="2" MarginBottom="2" Sprite="BlankWhiteSquare_9" Color="#0E0B08FF">
                      <Children>
                        <ImageIdentifierWidget DataSource="{Portrait}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ImageId="@Id" AdditionalArgs="@AdditionalArgs" TextureProviderName="@TextureProviderName" />
                      </Children>
                    </Widget>
                  </Children>
                </Widget>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="28" MarginLeft="156" MarginRight="186" MarginTop="34" Brush="Tvh.Text.Name" Text="@Name" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="22" MarginLeft="156" MarginRight="186" MarginTop="64" Brush="Tvh.Text.Small" Text="@SkillText" />
                <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40" MarginLeft="156" MarginRight="186" MarginTop="88" Brush="Tvh.Text.SmallTop" Text="@DetailText" />
                <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="36" MarginLeft="156" MarginRight="186" MarginTop="128" Brush="Tvh.Text.MutedTop" Text="@StatusText" />

                <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="160" HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="14" StackLayout.LayoutMethod="VerticalTopToBottom">
                  <Children>
                    <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="36" MarginBottom="8" Brush="Tvh.Button.Danger" Command.Click="ExecuteSpecial" IsVisible="@HasSpecial" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Text.Button" Text="@SpecialText" />
                      </Children>
                    </ButtonWidget>
                    <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="36" MarginBottom="8" Brush="Tvh.Button" Command.Click="ExecuteAssign" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Text.Button" Text="@ChangeText" />
                      </Children>
                    </ButtonWidget>
                    <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="36" Brush="Tvh.Button.Danger" Command.Click="ExecuteDismiss" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Text.Button" Text="@DismissText" />
                      </Children>
                    </ButtonWidget>
                  </Children>
                </ListPanel>
              </Children>
            </Widget>
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
