<?xml version="1.0" encoding="utf-8"?>
<!--
  Barış Masası (ViewModel: CheatMenu.UI.ViewModels.PeaceTableVM; UI.PeaceTableScreen). Pencere 1300x900: başlık, pazarlık gücün; solda
  istediklerin (TvhPeaceTerm, kaydırılır), sağda verdiklerin, özet, kabul olasılığı, Teklif et.
-->
<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

        <!-- Karartma: alttaki ekrana tıklanmasın -->
        <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Backdrop" DoNotPassEventsToChildren="true" />

        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1300" SuggestedHeight="900" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="StdAssets\Popup\canvas">
          <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="StdAssets\Popup\canvas_gradient" DoNotAcceptEvents="true" />

            <!-- ===== Başlık ===== -->
            <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="600" SuggestedHeight="52" MarginLeft="34" MarginTop="14" Brush="Tvh.Text.Title" Text="@Title" />
            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="160" SuggestedHeight="44" HorizontalAlignment="Right" MarginRight="30" MarginTop="18" Brush="Tvh.Button.Primary" Command.Click="ExecuteClose" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Text.Button" Text="@CloseText" />
              </Children>
            </ButtonWidget>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="23" VerticalAlignment="Top" MarginTop="76" MarginLeft="22" MarginRight="22" Sprite="StdAssets\Popup\divider" DoNotAcceptEvents="true" />
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="28" MarginLeft="34" MarginRight="34" MarginTop="100" Brush="Tvh.Text.Subtitle" Text="@Subtitle" />
            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="56" MarginLeft="34" MarginRight="34" MarginTop="132" Brush="Tvh.Text.SmallTop" Text="@LeverageText" />

            <!-- ===== Sol: istediklerin ===== -->
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="640" MarginLeft="30" MarginTop="196" MarginBottom="28">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="34" MarginLeft="10" Brush="Tvh.Text.Section" Text="@DemandsTitle" />
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="40" Sprite="BlankWhiteSquare_9" Color="#0D0A0799">
                  <Children>
                    <ScrollablePanel Id="DemandsScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="6" MarginRight="22" MarginTop="6" MarginBottom="6" AutoHideScrollBars="true" ClipRect="DemandsClip" InnerPanel="DemandsClip\DemandsList" VerticalScrollbar="..\DemandsBar\Scrollbar">
                      <Children>
                        <Widget Id="DemandsClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                          <Children>
                            <ListPanel Id="DemandsList" DataSource="{Demands}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <ItemTemplate>
                                <TvhPeaceTerm />
                              </ItemTemplate>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </ScrollablePanel>
                    <Standard.VerticalScrollbar Id="DemandsBar" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right" MarginRight="4" MarginTop="6" MarginBottom="6" />
                  </Children>
                </Widget>
              </Children>
            </Widget>

            <!-- ===== Sağ: verdiklerin, özet, olasılık, teklif ===== -->
            <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="570" HorizontalAlignment="Right" MarginRight="34" MarginTop="196" StackLayout.LayoutMethod="VerticalTopToBottom">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="34" MarginLeft="10" Brush="Tvh.Text.Section" Text="@OffersTitle" />
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="6" Sprite="BlankWhiteSquare_9" Color="#0D0A0799">
                  <Children>
                    <ListPanel DataSource="{Offers}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="6" MarginRight="6" MarginTop="6" MarginBottom="6" StackLayout.LayoutMethod="VerticalTopToBottom">
                      <ItemTemplate>
                        <TvhPeaceTerm />
                      </ItemTemplate>
                    </ListPanel>
                  </Children>
                </Widget>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="23" MarginTop="18" Sprite="StdAssets\Popup\divider" DoNotAcceptEvents="true" />
                <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="10" MarginRight="10" MarginTop="10" Brush="Tvh.Text.Body" Text="@SummaryText" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="48" MarginTop="16" Brush="Tvh.Text.PanelTitle" Text="@ChanceText" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26" Brush="Tvh.Text.StatLabel" Text="@WeightText" />
                <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="10" MarginRight="10" MarginTop="8" Brush="Tvh.Text.Bad" Text="@BlockedText" />
                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" MarginTop="16" StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <Children>
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="220" SuggestedHeight="48" MarginRight="16" Brush="Tvh.Button" Command.Click="ExecuteReset" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Text.Button" Text="@ResetText" />
                      </Children>
                    </ButtonWidget>
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="220" SuggestedHeight="48" Brush="Tvh.Button.Primary" Command.Click="ExecutePropose" IsEnabled="@CanPropose" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Tvh.Text.Button" Text="@ProposeText" />
                      </Children>
                    </ButtonWidget>
                  </Children>
                </ListPanel>
              </Children>
            </ListPanel>

            <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Popup.Frame" DoNotAcceptEvents="true" />
          </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>
