<?xml version="1.0" encoding="utf-8"?>
<!-- Divan listesinde bir satır (ViewModel: CouncilRowVM): bölüm başlığı, açıklama ya da kayıt (iki satır metin, sağda değer, isteğe bağlı düğme). -->
<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren">
      <Children>
        <!-- Bölüm başlığı -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="38" IsVisible="@IsHeader">
          <Children>
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" VerticalAlignment="Bottom" MarginBottom="4" Brush="Tvh.Text.Section" Text="@Text" />
          </Children>
        </Widget>

        <!-- Açıklama -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="44" IsVisible="@IsNote">
          <Children>
            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="14" MarginRight="14" Brush="Tvh.Text.MutedTop" Text="@Text" />
          </Children>
        </Widget>

        <!-- Kayıt -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="56" MarginBottom="4" Sprite="BlankWhiteSquare_9" Color="#1D1712FF" IsVisible="@IsRow">
          <Children>
            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="14" MarginRight="430" MarginTop="6" Brush="Tvh.Text.SmallTop" Text="@Text" />
            <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="180" HorizontalAlignment="Right" MarginRight="236" Brush="Tvh.Text.GoldRight" Text="@ValueText" IsVisible="@IsGood" />
            <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="180" HorizontalAlignment="Right" MarginRight="236" Brush="Tvh.Text.BadRight" Text="@ValueText" IsVisible="@IsBad" />
            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="210" SuggestedHeight="38" HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="12" Brush="Tvh.Button" Command.Click="ExecuteButton" IsVisible="@HasButton" IsEnabled="@IsButtonEnabled" UpdateChildrenStates="true" DoNotPassEventsToChildren="true">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="6" MarginRight="6" Brush="Tvh.Text.Button" Text="@ButtonText" />
              </Children>
            </ButtonWidget>
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
