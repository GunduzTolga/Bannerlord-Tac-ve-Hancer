<?xml version="1.0" encoding="utf-8"?>
<!--
  Taç ve Hançer arayüz fırçaları. Hepsi "Tvh." ile başlar.
  - Yalnızca oyunun her sürümünde bulunan düz beyaz kare sprite'ı (BlankWhiteSquare_9) kullanılır; renkler buradan verilir.
    Böylece oyun güncellemesinde bir sprite adı değişse bile ekran bozulmaz.
  - Yazı tipi adı yazılmaz: TvhUi.PrepareBrushes boş kalanlara oyunun varsayılan yazı tipini atar (Türkçe karakterler dahil).
  - Renk biçimi #RRGGBBAA.
-->
<Brushes>

  <!-- ===================== Yazılar ===================== -->

  <Brush Name="Tvh.Text.Title" FontSize="44" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#E8C77DFF" TextOutlineColor="#000000FF" TextOutlineAmount="0.2" TextGlowRadius="0" TextBlur="0" />
    </Styles>
  </Brush>

  <Brush Name="Tvh.Text.Subtitle" FontSize="19" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#BBA77FFF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" />
    </Styles>
  </Brush>

  <Brush Name="Tvh.Text.Section" FontSize="17" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#C9A45EFF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" />
    </Styles>
  </Brush>

  <Brush Name="Tvh.Text.Name" FontSize="24" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#F2E3C6FF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" />
    </Styles>
  </Brush>

  <Brush Name="Tvh.Text.NameCenter" FontSize="24" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#F2E3C6FF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" />
    </Styles>
  </Brush>

  <Brush Name="Tvh.Text.Body" FontSize="20" TextHorizontalAlignment="Left" TextVerticalAlignment="Top">
    <Styles>
      <Style Name="Default" FontColor="#E3D3B4FF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" />
    </Styles>
  </Brush>

  <Brush Name="Tvh.Text.BodyCenter" FontSize="21" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#C2B08EFF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" />
    </Styles>
  </Brush>

  <Brush Name="Tvh.Text.Small" FontSize="17" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#C2B08EFF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" />
    </Styles>
  </Brush>

  <Brush Name="Tvh.Text.SmallTop" FontSize="17" TextHorizontalAlignment="Left" TextVerticalAlignment="Top">
    <Styles>
      <Style Name="Default" FontColor="#C2B08EFF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" />
    </Styles>
  </Brush>

  <Brush Name="Tvh.Text.Muted" FontSize="16" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#8F8068FF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" />
    </Styles>
  </Brush>

  <Brush Name="Tvh.Text.MutedTop" FontSize="16" TextHorizontalAlignment="Left" TextVerticalAlignment="Top">
    <Styles>
      <Style Name="Default" FontColor="#8F8068FF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" />
    </Styles>
  </Brush>

  <Brush Name="Tvh.Text.Good" FontSize="18" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#9CCB7EFF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" />
    </Styles>
  </Brush>

  <Brush Name="Tvh.Text.GoodRight" FontSize="18" TextHorizontalAlignment="Right" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#9CCB7EFF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" />
    </Styles>
  </Brush>

  <Brush Name="Tvh.Text.Bad" FontSize="16" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#E07A6AFF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" />
    </Styles>
  </Brush>

  <Brush Name="Tvh.Text.BadTop" FontSize="16" TextHorizontalAlignment="Left" TextVerticalAlignment="Top">
    <Styles>
      <Style Name="Default" FontColor="#E07A6AFF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" />
    </Styles>
  </Brush>

  <Brush Name="Tvh.Text.Gold" FontSize="18" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#E8C77DFF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" />
    </Styles>
  </Brush>

  <Brush Name="Tvh.Text.GoldRight" FontSize="18" TextHorizontalAlignment="Right" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#E8C77DFF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" />
    </Styles>
  </Brush>

  <Brush Name="Tvh.Text.Caption" FontSize="16" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#C9A45EFF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" />
    </Styles>
  </Brush>

  <Brush Name="Tvh.Text.CardTitle" FontSize="34" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#F2E3C6FF" TextOutlineColor="#000000FF" TextOutlineAmount="0.15" TextGlowRadius="0" TextBlur="0" />
    </Styles>
  </Brush>

  <Brush Name="Tvh.Text.Placeholder" FontSize="40" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#5C4C36FF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" />
    </Styles>
  </Brush>

  <!-- Düğme yazıları: düğme "UpdateChildrenStates" ile durumunu yazıya da geçirir. -->

  <Brush Name="Tvh.Text.Button" FontSize="19" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#F2E3C6FF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" />
      <Style Name="Hovered" FontColor="#FFFFFFFF" />
      <Style Name="Pressed" FontColor="#E8C77DFF" />
      <Style Name="Selected" FontColor="#F7D58CFF" />
      <Style Name="Disabled" FontColor="#F2E3C6FF" TextAlphaFactor="0.4" />
    </Styles>
  </Brush>

  <Brush Name="Tvh.Text.Tab" FontSize="18" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#BBA77FFF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" />
      <Style Name="Hovered" FontColor="#F2E3C6FF" />
      <Style Name="Pressed" FontColor="#F2E3C6FF" />
      <Style Name="Selected" FontColor="#F7D58CFF" />
      <Style Name="Disabled" FontColor="#BBA77FFF" TextAlphaFactor="0.4" />
    </Styles>
  </Brush>

  <Brush Name="Tvh.Text.Option" FontSize="19" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#F2E3C6FF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" />
      <Style Name="Hovered" FontColor="#FFFFFFFF" />
      <Style Name="Pressed" FontColor="#E8C77DFF" />
      <Style Name="Disabled" FontColor="#F2E3C6FF" TextAlphaFactor="0.4" />
    </Styles>
  </Brush>

  <Brush Name="Tvh.Text.MapButton" FontSize="18" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#E8C77DFF" TextOutlineColor="#000000FF" TextOutlineAmount="0.2" TextGlowRadius="0" TextBlur="0" />
      <Style Name="Hovered" FontColor="#FFF1CCFF" />
      <Style Name="Pressed" FontColor="#C9A45EFF" />
    </Styles>
  </Brush>

  <Brush Name="Tvh.Text.Badge" FontSize="15" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#FFFFFFFF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" />
    </Styles>
  </Brush>

  <!-- ===================== Zeminler ve düğmeler ===================== -->

  <!-- Tam ekran karartma: alttaki haritaya tıklanmasın. -->
  <Brush Name="Tvh.Backdrop">
    <Layers>
      <BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.74" />
    </Layers>
    <Styles>
      <Style Name="Default" />
      <Style Name="Hovered" />
      <Style Name="Pressed" />
      <Style Name="Disabled" />
    </Styles>
  </Brush>

  <!-- Kenarlık katmanı (Frame) 1 piksel taşar; dolgu (Default) üstüne çizilir. -->
  <Brush Name="Tvh.Button">
    <Layers>
      <BrushLayer Name="Frame" Sprite="BlankWhiteSquare_9" Color="#8C6D3FFF" ExtendLeft="1" ExtendRight="1" ExtendTop="1" ExtendBottom="1" />
      <BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" Color="#3A2D1FFF" />
    </Layers>
    <Styles>
      <Style Name="Default" />
      <Style Name="Hovered">
        <BrushLayer Name="Frame" Color="#C9A45EFF" />
        <BrushLayer Name="Default" ColorFactor="1.35" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.8" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Frame" Color="#E8C77DFF" />
        <BrushLayer Name="Default" ColorFactor="1.5" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Frame" AlphaFactor="0.35" />
        <BrushLayer Name="Default" AlphaFactor="0.45" />
      </Style>
    </Styles>
    <SoundProperties>
      <EventSounds>
        <EventSound EventName="Click" Audio="default" />
      </EventSounds>
    </SoundProperties>
  </Brush>

  <Brush Name="Tvh.Button.Primary">
    <Layers>
      <BrushLayer Name="Frame" Sprite="BlankWhiteSquare_9" Color="#C9A45EFF" ExtendLeft="1" ExtendRight="1" ExtendTop="1" ExtendBottom="1" />
      <BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" Color="#7A2E22FF" />
    </Layers>
    <Styles>
      <Style Name="Default" />
      <Style Name="Hovered">
        <BrushLayer Name="Frame" Color="#F2D48CFF" />
        <BrushLayer Name="Default" ColorFactor="1.3" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.8" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Frame" AlphaFactor="0.35" />
        <BrushLayer Name="Default" AlphaFactor="0.4" />
      </Style>
    </Styles>
    <SoundProperties>
      <EventSounds>
        <EventSound EventName="Click" Audio="default" />
      </EventSounds>
    </SoundProperties>
  </Brush>

  <Brush Name="Tvh.Button.Danger">
    <Layers>
      <BrushLayer Name="Frame" Sprite="BlankWhiteSquare_9" Color="#9A4436FF" ExtendLeft="1" ExtendRight="1" ExtendTop="1" ExtendBottom="1" />
      <BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" Color="#4A1E19FF" />
    </Layers>
    <Styles>
      <Style Name="Default" />
      <Style Name="Hovered">
        <BrushLayer Name="Frame" Color="#D06A55FF" />
        <BrushLayer Name="Default" ColorFactor="1.4" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.8" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Frame" AlphaFactor="0.35" />
        <BrushLayer Name="Default" AlphaFactor="0.4" />
      </Style>
    </Styles>
    <SoundProperties>
      <EventSounds>
        <EventSound EventName="Click" Audio="default" />
      </EventSounds>
    </SoundProperties>
  </Brush>

  <!-- Sekme: seçiliyken koyu zemin; altındaki altın çizgi prefab'da. -->
  <Brush Name="Tvh.Tab">
    <Layers>
      <BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" Color="#2E2418FF" AlphaFactor="0.25" />
    </Layers>
    <Styles>
      <Style Name="Default" />
      <Style Name="Hovered">
        <BrushLayer Name="Default" AlphaFactor="0.7" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" AlphaFactor="0.9" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Default" AlphaFactor="1" ColorFactor="1.2" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" AlphaFactor="0.1" />
      </Style>
    </Styles>
    <SoundProperties>
      <EventSounds>
        <EventSound EventName="Click" Audio="default" />
      </EventSounds>
    </SoundProperties>
  </Brush>

  <!-- Listedeki seçilebilir satır (hedef, kişi). -->
  <Brush Name="Tvh.ListItem">
    <Layers>
      <BrushLayer Name="Frame" Sprite="BlankWhiteSquare_9" Color="#3D3022FF" ExtendLeft="1" ExtendRight="1" ExtendTop="1" ExtendBottom="1" />
      <BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" Color="#211A14FF" />
    </Layers>
    <Styles>
      <Style Name="Default" />
      <Style Name="Hovered">
        <BrushLayer Name="Frame" Color="#8C6D3FFF" />
        <BrushLayer Name="Default" ColorFactor="1.35" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.9" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Frame" Color="#C9A45EFF" />
        <BrushLayer Name="Default" Color="#3A2D1FFF" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" AlphaFactor="0.5" />
      </Style>
    </Styles>
    <SoundProperties>
      <EventSounds>
        <EventSound EventName="Click" Audio="default" />
      </EventSounds>
    </SoundProperties>
  </Brush>

  <!-- Olay kartındaki seçenek. -->
  <Brush Name="Tvh.Option">
    <Layers>
      <BrushLayer Name="Frame" Sprite="BlankWhiteSquare_9" Color="#6B5335FF" ExtendLeft="1" ExtendRight="1" ExtendTop="1" ExtendBottom="1" />
      <BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" Color="#2A2118FF" />
    </Layers>
    <Styles>
      <Style Name="Default" />
      <Style Name="Hovered">
        <BrushLayer Name="Frame" Color="#E8C77DFF" />
        <BrushLayer Name="Default" Color="#4A3926FF" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" Color="#5A4630FF" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Frame" AlphaFactor="0.35" />
        <BrushLayer Name="Default" AlphaFactor="0.5" />
      </Style>
    </Styles>
    <SoundProperties>
      <EventSounds>
        <EventSound EventName="Click" Audio="default" />
      </EventSounds>
    </SoundProperties>
  </Brush>

  <!-- Haritadaki "Entrika" düğmesi. -->
  <Brush Name="Tvh.MapButton">
    <Layers>
      <BrushLayer Name="Frame" Sprite="BlankWhiteSquare_9" Color="#C9A45EFF" ExtendLeft="1" ExtendRight="1" ExtendTop="1" ExtendBottom="1" />
      <BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" Color="#1A140FFF" AlphaFactor="0.92" />
    </Layers>
    <Styles>
      <Style Name="Default" />
      <Style Name="Hovered">
        <BrushLayer Name="Frame" Color="#F2D48CFF" />
        <BrushLayer Name="Default" Color="#3A2D1FFF" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" Color="#4A3926FF" />
      </Style>
    </Styles>
    <SoundProperties>
      <EventSounds>
        <EventSound EventName="Click" Audio="default" />
      </EventSounds>
    </SoundProperties>
  </Brush>

</Brushes>
