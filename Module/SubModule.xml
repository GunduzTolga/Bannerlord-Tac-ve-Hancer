<?xml version="1.0" encoding="utf-8"?>
<Module>
	<Name value="Taç ve Hançer"/>
	<Id value="CheatMenu"/>
	<Version value="v1.3.0"/>
	<SingleplayerModule value="true"/>
	<MultiplayerModule value="false"/>
	<DefaultModule value="false"/>
	<ModuleCategory value="Singleplayer"/>
	<ModuleType value="Community"/>
	<!-- Harmony, ButterLib, UIExtenderEx ve MCM: Nexus'tan ya da Steam Workshop'tan kurulur, Launcher'da bu modun üstünde olmalı. -->
	<DependedModules>
		<!-- Sürümler Workshop'taki kurulu sürümlerle aynı: oyun farklı her sürüm için açılışta "CAUTION" satırı yazıyor. -->
		<DependedModule Id="Bannerlord.Harmony" DependentVersion="v2.4.2.248" Optional="false"/>
		<DependedModule Id="Bannerlord.ButterLib" DependentVersion="v2.12.0" Optional="false"/>
		<DependedModule Id="Bannerlord.UIExtenderEx" DependentVersion="v3.0.3" Optional="false"/>
		<!-- Steam Workshop'taki MCM 5.12.3; modun kullandığı MCM API'si (attribute ayarları, Dropdown, SaveSettings) o sürümde de var. -->
		<DependedModule Id="Bannerlord.MBOptionScreen" DependentVersion="v5.12.3" Optional="false"/>
		<DependedModule Id="Native" DependentVersion="v1.4.8" Optional="false"/>
		<DependedModule Id="SandBoxCore" DependentVersion="v1.4.8" Optional="false"/>
		<DependedModule Id="Sandbox" DependentVersion="v1.4.8" Optional="false"/>
	</DependedModules>
	<!-- BUTR launcher / BLSE için yükleme sırası -->
	<DependedModuleMetadatas>
		<DependedModuleMetadata id="Bannerlord.Harmony" order="LoadBeforeThis"/>
		<DependedModuleMetadata id="Bannerlord.ButterLib" order="LoadBeforeThis"/>
		<DependedModuleMetadata id="Bannerlord.UIExtenderEx" order="LoadBeforeThis"/>
		<DependedModuleMetadata id="Bannerlord.MBOptionScreen" order="LoadBeforeThis"/>
		<DependedModuleMetadata id="Native" order="LoadBeforeThis"/>
		<DependedModuleMetadata id="SandBoxCore" order="LoadBeforeThis"/>
		<DependedModuleMetadata id="Sandbox" order="LoadBeforeThis"/>
	</DependedModuleMetadatas>
	<Xmls>
	</Xmls>
	<SubModules>
		<!-- İçine paketlenen modların uyum yamaları; onlardan önce başlamalı (bkz. src\Bundle\BundleShim.cs). -->
		<SubModule>
			<Name value="CheatMenu.Bundle"/>
			<DLLName value="CheatMenu.dll"/>
			<SubModuleClassType value="CheatMenu.Bundle.BundleShim"/>
			<Tags>
				<Tag key="DedicatedServerType" value="none"/>
			</Tags>
		</SubModule>
		<!-- tools\bundle.ps1 paketlenen modların alt modüllerini buraya, asıl modülümüzün önüne ekler. -->
		<SubModule>
			<Name value="CheatMenu"/>
			<DLLName value="CheatMenu.dll"/>
			<SubModuleClassType value="CheatMenu.SubModule"/>
			<Tags>
				<Tag key="DedicatedServerType" value="none"/>
			</Tags>
		</SubModule>
	</SubModules>
</Module>
