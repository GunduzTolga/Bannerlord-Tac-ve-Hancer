	<strings>
		<string id = "mcmwicmodname" text = "Women in Calradia" />
		
		<string id = "mcmwicgroup00" text = "Yeni bir oyuna başlamadan önce bu ayarların yapılandırılması tavsiye edilir." />

		<string id = "mcmwictitle00" text = "Yaşı Koru" />
		<string id = "mcmwictitle01" text = "Ekstra Etkileşimler" />
		<string id = "mcmwictitle02" text = "Şüpheli Bir Satıcı" />
		<string id = "mcmwictitle03" text = "Erkek Yoldaşlar" />
		<string id = "mcmwictitle04" text = "Rhagaea" />
		
		<string id = "mcmwichint00" text = "Eklenen karakterlerin yaşını, onları işe alana kadar korur." />
		<string id = "mcmwichint01" text = "Bu mod tarafından sağlanan ekstra etkileşimleri uygular." />
		<string id = "mcmwichint02" text = "Ekstra özelliklere sahip şüpheli bir satıcıyı dünyaya ekler." />
		<string id = "mcmwichint03" text = "Üç erkek yoldaş ekler. (Erkek karakterlerde yüz ve vücut derisi mükemmel şekilde hizalanmayabilir.)" />
		<string id = "mcmwichint04" text = "Rhagaea'nın görünümünü değiştirir." />
