    <string id="CA_mcm_g_budget" text="예산" />
    <string id="CA_mcm_g_purchases" text="구매" />
    <string id="CA_mcm_g_autonomy" text="자율성" />
    <string id="CA_mcm_g_display" text="표시" />
    <string id="CA_mcm_unlimited" text="무제한 예산 (기본값)" />
    <string id="CA_mcm_unlimited_hint" text="기본값이며, 동료마다 '가문 &gt; 부대'에서 바꿀 수 있습니다. 켜면 동료는 수당을 받지 않고 당신의 골드(최소 예비금 초과분)에서 직접 지출합니다. 당신이 부유할수록 더 좋은 장비를 갖춥니다." />
    <string id="CA_mcm_allowance" text="주간 수당 (기본값)" />
    <string id="CA_mcm_allowance_hint" text="기본값이며, 동료마다 '가문 &gt; 부대'에서 바꿀 수 있습니다. 매주 당신의 골드에서 지급되는 금액입니다." />
    <string id="CA_mcm_cap" text="지갑 한도" />
    <string id="CA_mcm_cap_hint" text="동료가 모을 수 있는 최대 금액입니다. 이를 넘으면 더 이상 수당을 받지 않습니다. 0 = 한도 없음." />
    <string id="CA_mcm_reserve" text="플레이어 최소 예비금" />
    <string id="CA_mcm_reserve_hint" text="수당이나 무제한 예산 구매로 인해 당신의 골드가 이 기준 아래로 내려가지 않습니다." />
    <string id="CA_mcm_family" text="가족 포함" />
    <string id="CA_mcm_family_hint" text="켜면 부대를 이끄는 가족도 적용됩니다 (영입한 동료만이 아니라)." />
    <string id="CA_mcm_refund" text="사망 시 환급" />
    <string id="CA_mcm_refund_hint" text="동료가 사망하면 지갑에 남은 돈이 당신에게 돌아옵니다." />
    <string id="CA_mcm_equip_share" text="장비 비율 (%)" />
    <string id="CA_mcm_equip_share_hint" text="동료가 도시를 방문할 때마다 장비에 쓸 수 있는 지갑의 비율입니다." />
    <string id="CA_mcm_troop_share" text="병력 비율 (%)" />
    <string id="CA_mcm_troop_share_hint" text="동료가 도시를 방문할 때마다 신병 모집에 쓸 수 있는 지갑의 비율입니다." />
    <string id="CA_mcm_slot_share" text="품목당 최대 (%)" />
    <string id="CA_mcm_slot_share_hint" text="장비 한 점의 가격은 남은 장비 예산의 이 비율을 넘을 수 없습니다. 지갑이 두둑할수록 더 비싼 물건을 삽니다." />
    <string id="CA_mcm_min_upgrade" text="교체 최소 향상도 (%)" />
    <string id="CA_mcm_min_upgrade_hint" text="현재 물건보다 최소 이만큼 좋아야 구매합니다 (불필요한 구매 방지)." />
    <string id="CA_mcm_sellback" text="기존 물품 되팔기 (%)" />
    <string id="CA_mcm_sellback_hint" text="동료가 물건을 교체할 때 돌려받는 판매가의 비율입니다." />
    <string id="CA_mcm_min_budget" text="구매 최소 예산" />
    <string id="CA_mcm_min_budget_hint" text="이 금액 미만이면 동료는 아무것도 사지 않습니다 (저축합니다)." />
    <string id="CA_mcm_cooldown" text="구매 간격 (일)" />
    <string id="CA_mcm_cooldown_hint" text="같은 동료의 두 번의 구매 사이 최소 일수입니다." />
    <string id="CA_mcm_max_recruits" text="방문당 최대 신병 수" />
    <string id="CA_mcm_max_recruits_hint" text="도시 방문마다 모집하는 최대 병사 수입니다." />
    <string id="CA_mcm_troop_cost" text="신병 비용 (%)" />
    <string id="CA_mcm_troop_cost_hint" text="지갑에서 지불하는 신병 가격의 배율입니다 (100% = 모드 기본 가격)." />
    <string id="CA_mcm_promote" text="병력 승급" />
    <string id="CA_mcm_promote_hint" text="켜면 동료가 지갑의 병력 비율을 먼저 숙련된 병사의 승급에 쓰고, 남은 돈으로 신병을 모집합니다." />
    <string id="CA_mcm_dismiss" text="편성 외 병력 해산" />
    <string id="CA_mcm_dismiss_hint" text="군대 편성이 있는 동료에게만 적용됩니다. 켜면 편성에 맞지 않는 병사가 알맞은 신병의 자리를 만들 때만 조금씩 해산됩니다." />
    <string id="CA_mcm_fill_free" text="빈 자리를 다른 병력으로 채우기" />
    <string id="CA_mcm_fill_free_hint" text="군대 편성이 설정된 동료에게만 적용됩니다. 켜면 편성에 포함되지 않은 자리를 마을의 아무 신병으로 채웁니다. 끄면 편성에 있는 병력만 모집합니다." />
    <string id="CA_mcm_buy_horse" text="말이 없으면 구매" />
    <string id="CA_mcm_buy_horse_hint" text="켜면 도보 동료가 필요한 승마 수준을 갖췄을 때 탈것(그다음 안장이나 마갑)을 삽니다." />
    <string id="CA_mcm_min_riding" text="첫 말에 필요한 최소 승마" />
    <string id="CA_mcm_min_riding_hint" text="도보 동료는 승마가 이 수준에 도달해야 첫 말을 삽니다 (순수 보병을 말에 태우지 않도록)." />
    <string id="CA_mcm_autoshop" text="자동 도시 방문 (기본값)" />
    <string id="CA_mcm_autoshop_hint" text="기본값이며, 동료마다 '가문 &gt; 부대'에서 바꿀 수 있습니다. 켜면 한동안 아무것도 사지 않은 부유한 동료가 스스로 가장 가까운 우호 도시로 가서 장비를 갖춥니다." />
    <string id="CA_mcm_autoshop_budget" text="출발 최소 지갑" />
    <string id="CA_mcm_autoshop_budget_hint" text="지갑이 이 금액에 도달해야 동료가 출발합니다 (무제한 예산일 때: 당신의 사용 가능한 골드)." />
    <string id="CA_mcm_autoshop_days" text="출발 전 미구매 일수" />
    <string id="CA_mcm_autoshop_days_hint" text="스스로 도시에 가기로 결정하기 전까지 아무것도 사지 않은 일수입니다." />
    <string id="CA_mcm_recruit_trips" text="모병 여행" />
    <string id="CA_mcm_recruit_trips_hint" text="군대 편성이 설정되어 있고 스스로 쇼핑하는 동료에게만 적용됩니다. 필요한 병력을 자기 지역에서 모집할 수 없으면, 그 병력을 제공하는 가장 가까운 우호 도시나 마을로 갑니다." />
    <string id="CA_mcm_recruit_distance" text="최대 여행 거리" />
    <string id="CA_mcm_recruit_distance_hint" text="모병 여행에서 동료가 갈 수 있는 최대 거리(지도 단위)입니다. 값이 클수록 칼라디아를 더 멀리 가로지를 수 있습니다." />
    <string id="CA_mcm_recruit_missing" text="여행 전 부족 병력 수" />
    <string id="CA_mcm_recruit_missing_hint" text="편성에서 병력이 최소 이만큼 부족할 때만 모병 여행을 떠납니다." />
    <string id="CA_mcm_noarmies" text="다른 영주의 군대에 합류하지 않음 (기본값)" />
    <string id="CA_mcm_noarmies_hint" text="기본값이며 동료마다 '가문 &gt; 부대'에서 바꿀 수 있습니다. 켜면 동료는 다른 영주가 이끄는 군대에 합류하기를 거부하고, 전투 중이 아니면 속한 군대를 바로 떠납니다. 당신의 군대에는 여전히 부를 수 있습니다." />
    <string id="CA_mcm_messages" text="메시지 표시" />
    <string id="CA_mcm_messages_hint" text="동료가 장비를 사거나, 병사를 모집하거나, 수당을 받을 때 메시지를 표시합니다." />
